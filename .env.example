# Local development: keep the credential outside this project.
VERTEX_SERVICE_ACCOUNT_FILE=D:\\path\\to\\service-account.json
VERTEX_LOCATION=global
VERTEX_TEXT_MODEL=gemini-3.5-flash
VERTEX_IMAGE_MODEL=gemini-3.1-flash-image

# Vercel: create this as a server-only, sensitive environment variable using
# the complete one-line JSON from the service-account file. Never expose it to
# browser code or use a public-prefixed variable.
# GOOGLE_SERVICE_ACCOUNT_JSON={...}
